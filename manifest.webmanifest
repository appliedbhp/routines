{
  "id": "/",
  "name": "Routines by ABHP",
  "short_name": "Routines",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f7fb",
  "theme_color": "#3185fc",
  "icons": [
    {
      "src": "assets/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "/open/",
      "accept": {
        "application/json": [
          ".abhp"
        ]
      },
      "icons": [
        {
          "src": "assets/app-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
          "src": "assets/app-icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "launch_type": "multiple-clients"
    }
  ]
}
